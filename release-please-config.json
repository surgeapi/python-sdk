{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/v17.3.0/schemas/config.json",
  "packages": {
    ".": {}
  },
  "include-v-in-tag": true,
  "include-component-in-tag": false,
  "versioning": "default",
  "prerelease": false,
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": false,
  "pull-request-header": "Automated Release PR",
  "release-type": "python",
  "extra-files": [
    "src/surge/_version.py",
    {
      "type": "toml",
      "path": "uv.lock",
      "jsonpath": "$.package[?(@.name.value == 'surge-sdk')].version"
    }
  ]
}
